# --- PayPal ---
# sim = no keys needed (fake but realistic order IDs); sandbox = real PayPal sandbox
PAYPAL_MODE=sim
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from your sandbox app (Developer Dashboard > app > Webhooks); required to accept webhooks in sandbox
PAYPAL_WEBHOOK_ID=

# --- LLM (any OpenAI-compatible endpoint; default is local Ollama) ---
# Leave LLM_BASE_URL empty to use the deterministic heuristic parsers only.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama

# --- App ---
DB_PATH=agentpay.db
POLICY_TIMEZONE=Asia/Kolkata
# auto = on in sim mode (simulated saved wallet), off in sandbox (PayPal popup); or force on/off
AUTOPAY=auto
# Optional: require this key from external agents calling POST /api/intents
AGENT_API_KEY=
