flowchart LR
    U(["You<br/>plain-English rules"]) --> RC["Rule compiler<br/><i>LLM → JSON</i><br/>+ regex fallback"]
    RC -->|"you confirm"| P[("Policy<br/>limits · budgets<br/>categories · quiet hours")]

    C(["Chat"]) --> AG["Shopping agent<br/><i>LLM picks products</i><br/>+ keyword fallback"]
    X(["Any AI agent<br/>MCP · REST"]) --> API
    AG --> API["Purchase intent<br/>product IDs + qty only"]

    API --> PE{{"Policy engine<br/><b>plain code decides</b><br/>prices from catalogue"}}
    P --> PE
    L[("Ledger<br/>SQLite audit log")] -->|"spend so far"| PE

    PE -->|APPROVE| PP["PayPal Orders v2<br/>create → approve → capture"]
    PE -->|HOLD| H["Approvals<br/>you approve or reject"]
    H -->|"re-check, then approve"| PP
    PE -->|BLOCK| L
    PP -->|"order + capture IDs"| L
    WH(["PayPal webhooks<br/>signature-verified"]) --> L

